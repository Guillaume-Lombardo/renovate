# Required: PAT for the gitlab.g1lom.xyz renovate-bot account.
# Scopes expected: api, read_user, read_repository, write_repository.
RENOVATE_TOKEN=

# Optional: GitHub token used only for github.com changelog/release note lookups.
GITHUB_COM_TOKEN=

# Commit author used by Renovate.
RENOVATE_GIT_AUTHOR="Renovate Bot <plain.rose9051@fastmail.com>"

# Limit autodiscovery. Keep this narrow because the bot account is an admin.
# Comma-separated GitLab path globs are accepted, for example:
# RENOVATE_AUTODISCOVER_FILTER=g1lom/*,infra/*
RENOVATE_AUTODISCOVER_FILTER=g1lom/*

# GitLab usernames to assign/review Renovate merge requests.
# Comma-separated values are accepted. Leave empty to disable a list.
RENOVATE_ASSIGNEES=g1lom
RENOVATE_REVIEWERS=g1lom

# GitLab usernames Renovate mentions in Dependency Dashboard issues.
# Comma-separated values are accepted. Values may be written with or without @.
RENOVATE_DASHBOARD_MENTIONS=g1lom

# Run interval for the long-running container. 21600 = every 6 hours.
RENOVATE_RUN_INTERVAL_SECONDS=21600

# Optional: admin PAT used before each Renovate run to add renovate-bot to
# every project owned by GITLAB_PROJECT_OWNER.
# Scope expected: api.
GITLAB_ADMIN_TOKEN=
GITLAB_URL=https://gitlab.g1lom.xyz
GITLAB_PROJECT_OWNER=g1lom
GITLAB_RENOVATE_BOT_USER_ID=
GITLAB_RENOVATE_ACCESS_LEVEL=30

# Renovate log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
